includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

    # Both sets live beyond the highest level, so no level contains them and raising the
    # level alone would not bring them in. They are the part that actually bites: the
    # strict set rejects the loose constructs the language still permits, and the
    # deprecation set fails on framework API scheduled for removal rather than leaving it
    # to be discovered at the next major upgrade.
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    paths:
        - app/
        - bin/

        # Whole, including `bootstrap/cache`, which Rector and Pint both exclude. The
        # asymmetry is deliberate: those two rewrite the framework's generated files and
        # would compete with the owner of them, whereas this only reads. Verified against a
        # tree with those files generated.
        - bootstrap/

        - config/
        - database/

        # The directory rather than its entry point alone, so that this list and Rector's
        # say the same thing. Only `index.php` is PHP today; the build output vite writes
        # here is not, and nothing else would be analysed by naming the directory.
        - public/

        - routes/
        - tests/

        # The two PHP files at the root. `artisan` carries no extension, so it is named as a
        # file rather than found: Pint reaches it through the `lint` script and Rector cannot
        # reach it at all, which leaves this the only analysis it gets. `rector.php` is the
        # newest file in the tree and was reaching no analyser.
        - artisan
        - rector.php

    # Pinned as an integer rather than written as `max`. The alias means "the highest that
    # exists", so a release adding a level would turn the pipeline red on a dependency
    # update nobody connected to it. Raising the bar should be a commit.
    level: 10

    phpVersion: 80500

    # Without this the analyser caches under the system temporary directory, where every
    # checkout and every worktree on the machine shares one cache keyed by nothing that
    # tells them apart. Deleting a worktree then breaks the analyser in the ones that
    # remain. The path is relative to this file, so each checkout gets its own.
    tmpDir: .phpstan.cache
